      <property name="styleSheet">
       <string notr="true">QPushButton {
	font: 10pt &quot;Segoe UI&quot;;
	font: 7pt &quot;Segoe UI&quot;;
    background-color: white;    /* Fond blanc */
    color: #5A9BD5;             /* Bleu clair pour le texte */
    font-size: 15px;
    font-weight: bold;
    border: 2px solid #5A9BD5;  /* Bordure bleu clair */
    border-radius: 10px;        /* Coins arrondis */
    padding: 10px 20px;
}

QPushButton:hover {
    background-color: #EFF6FB; /* Fond légèrement bleu au survol */
}

QPushButton:pressed {
    background-color: #D9ECFA; /* Fond bleu plus prononcé au clic */
}
</string>
