   <property name="styleSheet">
    <string notr="true">QWidget#form QLineEdit { 
    background-color: white; 
    border: 2px solid rgb(0, 165, 207); 
    border-radius: 10px; 
    font: bold 13px; 
    padding: 10px; 
    color: black; 
   
} 

QWidget#form QLineEdit:focus {
    background-color: #6BB8E3; 
    color: black;
}
QComboBox {
    background-color: #333333;
    color: white;
    border: 2px solid #555555;
    border-radius: 8px;
    padding: 10px;
    font-size: 13px;
}

QComboBox:focus {
    border: 2px solid #d4fcc3;
    background-color: #8eecf5
}

QComboBox:hover {
    background-color: #8eecf5;
}
#form {

    border: 2px solid #555555;
    border-radius: 10px;
    padding: 20px;
}
QRadioButton {
    font-family: &quot;Arial&quot;;
    font-size: 13px;
    color: #333;
    padding: 5px;
    border: 2px solid  rgb(0, 165, 207); 
    border-radius: 5px;
    background-color: #f0f0f0;
   
}

QRadioButton:hover {
    background-color: #c8e9a0;
   
}

QRadioButton:checked {
    color: #c8e9a0;
    background-color: #c8e9a0; /* Green for selected */
    border-color: #f6cfca;
}
#searchbar {
    background-color: #ffffff; /* Fond blanc */
    border-radius: 25px; /* Coins arrondis */
    border: 2px solid #606060; /* Bordure bleue */
    padding: 10px 20px; /* Espacement interne */
    font-size: 13px; /* Taille du texte */
    color: #2c3e50; /* Couleur du texte */
    width: 250px; /* Largeur de la barre */
    
}

/* Effet de focus (lorsque l'utilisateur clique dans la barre de recherche) */
#searchbar:focus {
    outline: none; /* Supprimer le contour par défaut */
    border-color: #606060; /* Bordure bleue au focus */
    
}

/* Effet au survol (lorsque la souris passe dessus) */
#searchbar:hover {
    border-color: rgb(0, 165, 207); /* Bordure plus claire */
    
}
#recherche{
border: none; 
}
QFrame#menubar QPushButton {
    background-color: white;
    color: black;
    border: 1px solid white;
 font-size: 13px;
    font-weight: bold;
   
    min-width: 80px; /* Ajuste la largeur des boutons */
}

QFrame#menubar QPushButton:hover {
    background-color: #c8e9a0;
    color: white;
}

QFrame#menubar QPushButton:pressed {
    background-color:#cace81;
    color: white;
}
/* Style général du tableau */
QTableWidget#tab_affichage {
    background-color: white; /* Bleu clair */
    border: 2px solid #2196F3; /* Bleu foncé */
    border-radius: 10px;
    gridline-color: #90CAF9; /* Bleu plus clair pour les lignes */
    font: bold 13px &quot;Segoe UI&quot;;
    selection-background-color: #64B5F6; /* Bleu moyen quand une ligne est sélectionnée */
    selection-color: white;
}

/* En-tête du tableau */
QHeaderView::section {
    background-color: #bfe5f5; /* Bleu foncé */
    color: white;
    padding: 5px;
    border: 1px solid black;
    font: bold 13px &quot;Segoe UI&quot;;
}

/* Style des lignes impaires */
QTableWidget#tab_affichage::item:alternate {
    background-color: white; /* Bleu plus clair */
}

/* Style de la scrollbar verticale */
/* Scrollbar verticale */
QScrollBar:vertical {
    border: 1px solid #1976D2;
    background: #E3F2FD;
    width: 12px;
    margin: 2px;
    border-radius: 6px;
}

QScrollBar::handle:vertical {
    background: #64B5F6;
    min-height: 30px;
    border-radius: 6px;
}

QScrollBar::add-line:vertical, 
QScrollBar::sub-line:vertical {
    background: none;
}

/* Scrollbar horizontale */
QScrollBar:horizontal {
    border: 1px solid #1976D2;
    background: #E3F2FD;
    height: 12px;
    margin: 2px;
    border-radius: 6px;
}

QScrollBar::handle:horizontal {
    background: #64B5F6;
    min-width: 30px;
    border-radius: 6px;
}

QScrollBar::add-line:horizontal, 
QScrollBar::sub-line:horizontal {
    background: none;
}
QWidget#metier QPushButton {
    /* Style général des boutons */
    background-color: transparent; /* Vert */
    color: black;
    font-size: 13px;
    font-weight: bold;
    border-radius: 15px; /* Bords arrondis */
    padding: 8px 20px; /* Espacement interne */
    border: none;
}

/* Effet au survol */
QWidget#metier QPushButton:hover {
    background-color: #c2eeff; /* Vert plus foncé */
}

/* Effet au clic */
QWidget#metier QPushButton:pressed {
    background-color: #99e1ea; /* Vert encore plus foncé */
}


</string>
